    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#FF6A2B"
                android:endColor="#FF3D6E" />
        </aapt:attr>
    </path>
    <!-- A soft light in the top-right corner, as on the in-app hero cards. -->
