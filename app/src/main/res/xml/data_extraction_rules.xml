<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same as backup_rules.xml, for the Google Drive backup and for moving to a
     new phone (device-to-device transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="bujirun.db" />
        <include domain="sharedpref" path="prefs.xml" />
        <include domain="sharedpref" path="account.xml" />
        <include domain="file" path="profile.jpg" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="bujirun.db" />
        <include domain="sharedpref" path="prefs.xml" />
        <include domain="sharedpref" path="account.xml" />
        <include domain="file" path="profile.jpg" />
    </device-transfer>
</data-extraction-rules>
